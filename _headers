# Cloudflare Pages читает этот файл сам, ничего настраивать не нужно.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Иконки и манифест лежат в корне и меняются редко, но не «навсегда»:
# неделя — компромисс между кешем и возможностью поправить иконку.
/favicon.ico
  Cache-Control: public, max-age=604800

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=604800

# Разметка, стили и скрипт лежат в корне и меняются при каждой правке сайта.
# no-cache не запрещает кеш, а требует спросить сервер, не изменился ли файл, —
# иначе браузер может неделю показывать старую версию по своим эвристикам.
/index.html
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/script.js
  Cache-Control: no-cache

/*
  # Год HSTS. Включать ТОЛЬКО когда сайт уже открывается по https —
  # на Cloudflare Pages это так с первой публикации.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  # Сайту не нужны ни камера, ни микрофон, ни геопозиция — закрываем заранее.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Разрешено ровно то, что сайт реально грузит: свои файлы и шрифты Google.
  # 'unsafe-inline' в style-src нужен из-за style="--delay:..." в разметке.
  # Хеш в script-src — это блок структурированных данных JSON-LD в <head>.
  # Если будете править его текст, хеш перестанет совпадать: в консоли появится
  # предупреждение (на вид сайта это не влияет), пересчитать можно командой из README.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-hgltLfHdhIS3eSIPaokM56qM9tYzJen5cXBDbpWwwb4='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'
