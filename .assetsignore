# Что не загружать на Cloudflare. Файл работает как .gitignore,
# но для выгрузки статики — Wrangler читает именно его, а не .gitignore.

# Мастер-файлы и исходники: ~140 МБ, среди них макеты клиентов.
assets/img
assets/raw

# Служебное и то, что не нужно посетителю сайта.
.git
.gitignore
.assetsignore
.DS_Store
README.md
wrangler.jsonc
